### 第4幕：ルーマニア参戦 ###

country_event = {
	id = tsr_balkan_war.8
	title = tsr_balkan_war.8.t
	desc = tsr_balkan_war.8.d
	picture = GFX_report_event_PLACEHOLDER

	is_triggered_only = yes

	trigger = {
		HUN = { has_war_with = YUG }
	}

	option = {
		name = tsr_balkan_war.8.a
		add_war_support = 0.1
		add_to_war = {
			targeted_alliance = YUG
			enemy = HUN
		}
		add_ideas = tsr_transylvania_irredentism
		HUN = { country_event = { id = tsr_balkan_war.9 days = 1 } }
	}
}

