add_namespace = tsr_balkan_war

### 第1幕：国境事変 ###

country_event = {
	id = tsr_balkan_war.1
	title = tsr_balkan_war.1.t
	desc = tsr_balkan_war.1.d
	picture = GFX_report_event_PLACEHOLDER

	is_triggered_only = no

	trigger = {
		date > 1936.10.1
		NOT = { date > 1936.12.31 }
		tag = HUN
		NOT = { has_country_flag = tsr_balkan_war_started }
	}

	mean_time_to_happen = {
		days = 14
	}

	immediate = {
		set_country_flag = tsr_balkan_war_started
	}

	option = {
		name = tsr_balkan_war.1.a
		add_political_power = -25
		add_war_support = 0.05
		YUG = { country_event = { id = tsr_balkan_war.2 days = 45 } }
	}
}

### 第2幕：開戦 ###

country_event = {
	id = tsr_balkan_war.2
	title = tsr_balkan_war.2.t
	desc = tsr_balkan_war.2.d
	picture = GFX_report_event_PLACEHOLDER

	is_triggered_only = yes

	option = {
		name = tsr_balkan_war.2.a
		add_war_support = 0.1
		create_faction = tsr_balkan_entente
		declare_war_on = {
			target = HUN
			type = annex_everything
		}
		HUN = { country_event = { id = tsr_balkan_war.3 days = 1 } }
		GER = { country_event = { id = tsr_balkan_war.4 days = 3 } }
		RUS = { country_event = { id = tsr_balkan_war.5 days = 3 } }
		ROM = { country_event = { id = tsr_balkan_war.8 days = 45 } }
		HUN = { country_event = { id = tsr_balkan_war.10 days = 30 } }
	}
}

# HUN宣戦通知
country_event = {
	id = tsr_balkan_war.3
	title = tsr_balkan_war.3.t
	desc = tsr_balkan_war.3.d
	picture = GFX_report_event_PLACEHOLDER

	is_triggered_only = yes

	option = {
		name = tsr_balkan_war.3.a
		add_war_support = 0.15
		add_stability = -0.1
	}
}

### 第3幕：代理戦争 ###

# ドイツがハンガリー支援
country_event = {
	id = tsr_balkan_war.4
	title = tsr_balkan_war.4.t
	desc = tsr_balkan_war.4.d
	picture = GFX_report_event_PLACEHOLDER

	is_triggered_only = yes

	option = {
		name = tsr_balkan_war.4.a
		add_political_power = -50
		HUN = {
			add_ideas = tsr_german_proxy_support
			add_equipment_to_stockpile = {
				type = infantry_equipment
				amount = 2000
			}
			add_equipment_to_stockpile = {
				type = artillery_equipment
				amount = 200
			}
			country_event = { id = tsr_balkan_war.6 days = 2 }
		}
	}
}

