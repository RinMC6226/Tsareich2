### 第5幕：内部崩壊 ###

# 離間工作ポーリング（hidden）
country_event = {
	id = tsr_balkan_war.10
	title = tsr_balkan_war.10.t
	desc = tsr_balkan_war.10.d

	hidden = yes
	is_triggered_only = yes

	trigger = {
		has_war_with = YUG
		NOT = { has_country_flag = tsr_balkan_subversion_fired }
	}

	immediate = {
		if = {
			limit = { surrender_progress > 0.3 }
			set_country_flag = tsr_balkan_subversion_fired
			country_event = { id = tsr_balkan_war.11 days = 5 }
		}
		if = {
			limit = {
				NOT = { surrender_progress > 0.3 }
				has_war_with = YUG
			}
			country_event = { id = tsr_balkan_war.10 days = 15 }
		}
	}

	option = {
		name = tsr_balkan_war.10.a
	}
}

# 少数民族蜂起
country_event = {
	id = tsr_balkan_war.11
	title = tsr_balkan_war.11.t
	desc = tsr_balkan_war.11.d
	picture = GFX_report_event_PLACEHOLDER

	is_triggered_only = yes

	option = {
		name = tsr_balkan_war.11.a
		add_stability = -0.15
		add_war_support = -0.1
		tsr_balkan_war_release_banat = yes
		tsr_balkan_war_release_slovakia = yes
		tsr_balkan_war_release_ruthenia = yes
		country_event = { id = tsr_balkan_war.15 days = 10 }
	}
}

